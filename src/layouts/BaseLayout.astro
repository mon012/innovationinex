---
import { navigation } from "../data/site";
import SiteImage from "../components/SiteImage.astro";
import logoImage from "../assets/images/inex-logo.png";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  robots?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: { name: string; url: string }[];
}

const { title, description, image = "/wp-content/uploads/2021/07/cleanroom-class.jpg", type = "website", robots, schema, breadcrumbs } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const ogImageUrl = new URL(image, Astro.site);
if (breadcrumbs?.length) {
  const trail = [{ name: "Home", url: "/" }, ...breadcrumbs];
  schemas.push({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: trail.map((item, index) => ({
      "@type": "ListItem", position: index + 1, name: item.name, item: new URL(item.url, Astro.site).href
    }))
  });
}
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/wp-content/uploads/2020/10/cropped-Copy-of-iNEX-192x192.png" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="iNEX Innovation" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-nav">
      <nav class="nav-inner" aria-label="Primary navigation">
        <a class="nav-logo" href="/" aria-label="iNEX home"><SiteImage src={logoImage} alt="iNEX" width={240} widths={[120, 240]} sizes="(max-width: 900px) 120px, 160px" loading="eager" decoding="async" /></a>
        <div class="nav-links" id="nav-links">
          {navigation.filter((item) => item.href !== "/article/" && item.href !== "/contact/").map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="nav-cta" href="/contact/">Talk to an engineer</a>
        </div>
        <button class="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false" aria-label="Open navigation">Menu</button>
      </nav>
    </header>
    <main class="page"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <a class="footer-logo" href="/" aria-label="iNEX home"><SiteImage src={logoImage} alt="iNEX" width={240} widths={[120, 240]} sizes="(max-width: 900px) 120px, 160px" loading="lazy" decoding="async" /></a>
          <p>ออกแบบและพัฒนาระบบคุณภาพอากาศสำหรับอุตสาหกรรม อาคารพาณิชย์ และที่อยู่อาศัย</p>
        </div>
        <div class="footer-col"><h3>Explore</h3><a href="/solution/">Solutions</a><a href="/article/">Insights</a><a href="/about/">Company</a></div>
        <div class="footer-col"><h3>Solutions</h3><a href="/solution/commercial/">Commercial</a><a href="/solution/residential/">Residential</a></div>
        <div class="footer-col"><h3>Information</h3><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/contact/">Contact</a></div>
      </div>
      <div class="shell footer-bottom"><span>© <span data-current-year>{new Date().getFullYear()}</span> ECO Value Power Co.,Ltd</span><span>Engineered for better air.</span></div>
    </footer>
    <script is:inline>
      const toggle = document.querySelector('.nav-toggle');
      const links = document.querySelector('.nav-links');
      const menuItems = links ? [...links.querySelectorAll('a')] : [];
      const setMenuState = (open, { restoreFocus = false } = {}) => {
        if (!toggle || !links) return;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        toggle.textContent = open ? 'Close' : 'Menu';
        links.setAttribute('data-open', String(open));
        document.body.toggleAttribute('data-nav-open', open);
        if (open) menuItems[0]?.focus();
        if (!open && restoreFocus) toggle.focus();
      };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        setMenuState(!open);
      });
      links?.addEventListener('click', (event) => {
        if (event.target.closest('a')) setMenuState(false);
      });
      document.addEventListener('keydown', (event) => {
        if (toggle?.getAttribute('aria-expanded') !== 'true') return;
        if (event.key === 'Escape') {
          event.preventDefault();
          setMenuState(false, { restoreFocus: true });
          return;
        }
        if (event.key !== 'Tab' || !links) return;
        const focusable = [toggle, ...menuItems];
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
      window.addEventListener('resize', () => {
        if (window.innerWidth > 900 && toggle?.getAttribute('aria-expanded') === 'true') setMenuState(false);
      });
      const currentYear = document.querySelector('[data-current-year]');
      if (currentYear) currentYear.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>
